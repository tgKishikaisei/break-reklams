{
  "manifest_version": 3,
  "name": "Break Reklams — блокировщик рекламы",
  "short_name": "Break Reklams",
  "version": "1.0.0",
  "description": "Убирает рекламу, трекеры и всплывающие окна на сайтах и YouTube. Быстро, без слежки, на новом движке Chrome.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Break Reklams",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "trackers", "enabled": true, "path": "rules/trackers.json" },
      { "id": "annoyances", "enabled": false, "path": "rules/annoyances.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/cosmetic.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["resources/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "start-picker": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Убрать элемент со страницы"
    }
  }
}
