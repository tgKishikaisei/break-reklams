{
  "name": "break-reklams",
  "version": "1.0.0",
  "private": true,
  "description": "Break Reklams — блокировщик рекламы для Chrome, Edge, Яндекс.Браузера, Opera, Brave и Firefox (Manifest V3)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "update": "node tools/update-lists.mjs",
    "icons": "node tools/make-icons.mjs",
    "package": "node tools/package.mjs",
    "hosts": "node tools/make-hosts.mjs",
    "lint:text": "node tools/check-text.mjs",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "e2e": "node test/e2e.mjs",
    "check": "npm run lint:text && npm test"
